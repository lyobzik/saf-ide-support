{
  "name": "smartapp-dsl",
  "displayName": "SmartApp DSL",
  "description": "Поддержка DSL-сценариев Sber SmartApp Framework: навигация, автодополнение, подсветка и диагностика в static/references/**/*.json",
  "version": "0.1.0",
  "publisher": "ru-sber-smartapp",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:python"
  ],
  "contributes": {
    "semanticTokenTypes": [
      {
        "id": "smartappKeyword",
        "superType": "keyword",
        "description": "Значение type, являющееся ключевым словом SmartApp DSL"
      },
      {
        "id": "smartappStructuralKey",
        "superType": "property",
        "description": "Структурный ключ SmartApp DSL (form, actions, fields, …)"
      },
      {
        "id": "smartappJinjaDelimiter",
        "superType": "operator",
        "description": "Разделители Jinja: {{ }} и {% %}"
      },
      {
        "id": "smartappJinjaVariable",
        "superType": "variable",
        "description": "Переменная внутри Jinja-выражения"
      },
      {
        "id": "smartappJinjaOperator",
        "superType": "operator",
        "description": "Доступ к полю внутри Jinja-выражения"
      },
      {
        "id": "smartappJinjaFilter",
        "superType": "function",
        "description": "Оператор фильтра и имя фильтра Jinja"
      },
      {
        "id": "smartappJinjaString",
        "superType": "string",
        "description": "Строковый литерал внутри Jinja-выражения"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "json",
        "scopes": {
          "smartappKeyword": [
            "keyword.control.smartapp"
          ],
          "smartappStructuralKey": [
            "support.type.property-name.json"
          ],
          "smartappJinjaDelimiter": [
            "punctuation.section.embedded.smartapp"
          ],
          "smartappJinjaVariable": [
            "variable.other.smartapp"
          ],
          "smartappJinjaOperator": [
            "punctuation.accessor.smartapp",
            "punctuation.section.embedded"
          ],
          "smartappJinjaFilter": [
            "support.function.smartapp"
          ],
          "smartappJinjaString": [
            "string.quoted.single.smartapp"
          ]
        }
      }
    ]
  },
  "scripts": {
    "verify:contract": "node scripts/verify-contract.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "compile": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "package": "node scripts/package.mjs",
    "vscode:prepublish": "npm run compile",
    "test:unit": "vitest run",
    "test:integration": "npm run compile && node scripts/build-tests.mjs && vscode-test",
    "test": "npm run verify:contract && npm run typecheck && npm run test:unit",
    "lint": "eslint src test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "ajv": "^8.17.1",
    "esbuild": "^0.23.0",
    "eslint": "^8.57.0",
    "jsonc-parser": "^3.3.1",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/lyobzik/saf-ide-support.git"
  }
}
