<idea-plugin>
    <id>ru.sber.smartapp.dsl</id>
    <name>SmartApp DSL</name>
    <vendor>ru.sber.smartapp</vendor>

    <description><![CDATA[
        Поддержка DSL-файлов сценариев Sber SmartApp Framework (JSON в
        <code>static/references/</code>): подсветка ключевых слов, переход к
        определению, поиск использований, автодополнение и предупреждения о
        неразрешённых ссылках.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.json</depends>

    <extensions defaultExtensionNs="com.intellij">
        <annotator
            language="JSON"
            implementationClass="ru.sber.smartapp.dsl.annotator.SmartAppAnnotator"/>

        <psi.referenceContributor
            language="JSON"
            implementation="ru.sber.smartapp.dsl.reference.SmartAppReferenceContributor"/>

        <completion.contributor
            language="JSON"
            implementationClass="ru.sber.smartapp.dsl.completion.SmartAppCompletionContributor"/>

        <fileBasedIndex
            implementation="ru.sber.smartapp.dsl.index.SmartAppDefinitionIndex"/>

        <fileBasedIndex
            implementation="ru.sber.smartapp.dsl.index.SmartAppNameIndex"/>

        <fileBasedIndex
            implementation="ru.sber.smartapp.dsl.index.SmartAppFormFieldIndex"/>

        <fileBasedIndex
            implementation="ru.sber.smartapp.dsl.index.SmartAppFormFieldNameIndex"/>

        <lang.findUsagesProvider
            language="JSON"
            implementationClass="ru.sber.smartapp.dsl.findusages.SmartAppFindUsagesProvider"/>

        <elementDescriptionProvider
            implementation="ru.sber.smartapp.dsl.findusages.SmartAppElementDescriptionProvider"/>

        <colorSettingsPage
            implementation="ru.sber.smartapp.dsl.highlight.SmartAppColorSettingsPage"/>
    </extensions>
</idea-plugin>
